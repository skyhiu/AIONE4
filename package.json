{
  "name": "aione4",
  "private": true,
  "version": "4.0.0-alpha.23",
  "description": "AIONE 4: a fullscreen, controller-first game launcher for Windows (personal use).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mock": "vite build --mode mock --outDir dist-mock",
    "preview:mock": "vite preview --mode mock --outDir dist-mock --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:ui": "playwright test",
    "check:version": "node scripts/check-version.mjs",
    "tauri": "tauri",
    "check:assets": "node scripts/check-assets.mjs",
    "check:built": "node scripts/check-built-sounds.mjs",
    "build:boot-preview": "vite build --config tools/brand/boot-preview/vite.config.ts && node tools/brand/boot-preview/finish.mjs dist-boot-preview"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.0",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "material-symbols": "0.47.5",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
